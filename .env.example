# Sao chép file này thành `.env` rồi điền giá trị thật.
# `.env` đã nằm trong .gitignore — không bao giờ commit.
#
# Quy ước: khoá nào chạy trong app thì client đọc được, nên KHÔNG được
# đặt bí mật thật vào nhóm CLIENT. Bảo vệ dữ liệu bằng RLS ở Supabase,
# không bằng cách giấu khoá.

# ─────────────────────────────────────────────────────────────
#  CLIENT — được đóng gói vào app, coi như công khai
# ─────────────────────────────────────────────────────────────

# Supabase (Auth + Postgres/PostGIS + Storage)
# Dùng khoá `sb_publishable_…`, KHÔNG dùng anon key kiểu JWT cũ — nó đã bị
# deprecated và sẽ bị bỏ. Khoá này không phải bí mật: nó nằm trong app, ai cũng
# đọc được. Thứ bảo vệ dữ liệu là RLS, không phải khoá.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Nhà cung cấp tile bản đồ (MapTiler hoặc Protomaps — chốt ở F3)
MAP_STYLE_URL=
MAP_TILE_API_KEY=

# Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ─────────────────────────────────────────────────────────────
#  SERVER / CÔNG CỤ — chỉ dùng ở máy dev, seed script, CI.
#  ⛔ Tuyệt đối không đưa vào app.
# ─────────────────────────────────────────────────────────────

# Bỏ qua RLS — dùng cho script seed nội dung pilot
SUPABASE_SERVICE_ROLE_KEY=

# Dùng cho `supabase link` / chạy migration
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Soạn nháp chương truyện (công cụ offline, không nằm trong app)
ANTHROPIC_API_KEY=
