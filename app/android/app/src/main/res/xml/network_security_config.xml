<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP stays off everywhere except the loopback address.

    The offline map download needs it. MapLibre's offline API takes a style
    URL rather than a style document, and on Android it resolves that URL
    through the HTTP stack alone — file:// and asset:// never reach a file
    source. So the app serves the generated style to itself on 127.0.0.1 for
    the few seconds a download takes.

    Nothing leaves the device over this. Every real endpoint — tiles, glyphs,
    Supabase — is HTTPS and stays subject to the default policy below.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
